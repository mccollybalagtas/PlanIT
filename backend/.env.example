# ============================================
# PlanIt Backend Environment Configuration
# ============================================
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to version control.

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/plannerhub
DATABASE_URL=
POSTGRES_URL=
SQL_PATH=./data/plannerhub.sqlite
UPLOAD_DIR=./uploads

# Security - REQUIRED in production
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-very-long-random-string-at-least-32-characters-long
SESSION_SECRET=replace-me-too-with-another-random-secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Password policy
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# Email (for password resets and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
